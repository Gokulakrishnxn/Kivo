# ---- OS ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
# macOS custom folder icon is literally "Icon\r". The common `Icon?` form
# also matches `icons` on a case-insensitive filesystem, which silently
# swallowed the app icon directory.
Icon[\r]

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ---- Build output ----
dist/
build/
out/
_site/
.next/
.output/
.turbo/
*.tsbuildinfo

# ---- Rust / native (future app targets) ----
target/
**/*.rs.bk
Cargo.lock.bak

# ---- Swift / Xcode (future macOS target) ----
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
.build/

# ---- Env & secrets ----
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
secrets.json

# ---- Models & audio scratch ----
models/*.bin
models/*.gguf
models/*.onnx
*.wav
*.flac
!brand/**/*.wav

# ---- Coverage & test ----
coverage/
.nyc_output/
*.lcov

# ---- macOS app build ----
src-tauri/target/
src-tauri/gen/
dist/
src-tauri/frameworks/

# ---- Signing material — never commit any of this ----
*.p12
*.cer
*.certSigningRequest
*.provisionprofile
*.mobileprovision
*.keychain
*.keychain-db
notarize.json
AuthKey_*.p8
